{
  "name": "n8n-nodes-gsc-wizard",
  "version": "0.1.3",
  "description": "n8n node for GSC Wizard: Google Search Console, GA4, URL inspection, sitemaps, IndexNow and SEO insights in your workflows",
  "license": "MIT",
  "homepage": "https://github.com/jbobbink/n8n-nodes-gsc-wizard#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "gsc-wizard",
    "google-search-console",
    "search-console",
    "seo",
    "ga4",
    "indexnow"
  ],
  "author": {
    "name": "Jan-Willem Bobbink",
    "email": "jwbobbink@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbobbink/n8n-nodes-gsc-wizard.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "n8n-node build && node --test test/*.test.js"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/GscWizardApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GscWizard/GscWizard.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.55.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/jbobbink/n8n-nodes-gsc-wizard/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
