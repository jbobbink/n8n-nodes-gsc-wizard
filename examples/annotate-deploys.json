{
	"name": "GSC Wizard: annotate every deploy",
	"nodes": [
		{
			"parameters": { "httpMethod": "POST", "path": "deployed", "options": {} },
			"id": "5d6e7f80-1a2b-4c3d-9e8f-0a1b2c3d4e01",
			"name": "Deploy Finished",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [0, 0],
			"webhookId": "5d6e7f80-1a2b-4c3d-9e8f-0a1b2c3d4e99"
		},
		{
			"parameters": {
				"resource": "annotation",
				"operation": "create",
				"scope": "property",
